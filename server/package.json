{
  "name": "evalexam-scan-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend proxy de EvalExam: recibe la foto de la hoja de respuestas y llama a Gemini (gemini-3.6-flash) con la API key del lado servidor.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
